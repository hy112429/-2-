# 仅供 Linux 虚拟机部署时参考。正式文件放在 /etc/touguang-center/center.env，权限 0600。
SPRING_PROFILES_ACTIVE=prod
SERVER_BIND_ADDRESS=0.0.0.0
SERVER_PORT=8080
DB_URL="jdbc:mysql://127.0.0.1:3306/touguang_center?sslMode=DISABLED&serverTimezone=Asia/Shanghai"
DB_USERNAME=touguang_app
DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DB_MIGRATION_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_REDIS_PASSWORD
