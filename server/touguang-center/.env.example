# 复制为 .env 后填写，仅供本机 Compose 联调。不要提交真实密码。
MYSQL_ROOT_PASSWORD=replace-with-a-long-local-only-password
MYSQL_DATABASE=touguang_center
MYSQL_USER=touguang_app
MYSQL_PASSWORD=replace-with-a-different-long-local-only-password
REDIS_PASSWORD=replace-with-another-long-local-only-password
MYSQL_HOST_PORT=13306
REDIS_HOST_PORT=16379
APP_HOST_PORT=8080

# Spring Boot（本机直接运行时使用）
DB_HOST=127.0.0.1
DB_PORT=13306
DB_NAME=touguang_center
DB_USERNAME=touguang_app
DB_PASSWORD=replace-with-a-different-long-local-only-password
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_USERNAME=
SERVER_PORT=8080
